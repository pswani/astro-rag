{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make lint)", "Bash(make test)", "Bash(make verify)",
      "Bash(uv run --extra dev pytest:*)", "Bash(uv run --extra dev ruff check:*)", "Bash(uv run --extra dev lint-imports)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
